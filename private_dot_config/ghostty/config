# Ghostty Native Agent Workflow Configuration
# Fixed for Ghostty 1.3.1

# UI & Performance
theme = Catppuccin Mocha
window-theme = system
background-opacity = 0.9
background-blur = true

# Typography
font-family = JetBrainsMono Nerd Font
font-size = 12
adjust-cell-height = 20%
# font-thicken = false (Deprecated or moved in 1.3.x)

# Layout
window-padding-x = 10
window-padding-y = 10
window-decoration = true
confirm-close-surface = false

# Cursor
cursor-style = block
# cursor-style-blink = true

# Reserve Ctrl+Alt for Ghostty so child applications can own Alt bindings.
keybind = ctrl+alt+d=new_split:right
keybind = ctrl+alt+shift+d=new_split:down
keybind = ctrl+alt+h=goto_split:left
keybind = ctrl+alt+l=goto_split:right
keybind = ctrl+alt+k=goto_split:up
keybind = ctrl+alt+j=goto_split:down
keybind = ctrl+alt+enter=toggle_split_zoom
